# 虚拟环境（不要提交，别人用自己的电脑重新建）
venv/
.venv/

# Python 运行产生的缓存
__pycache__/
*.py[cod]

# 本地数据库文件（账目数据不进 Git）
*.db
*.sqlite
*.sqlite3

# 环境变量 / 密钥（API Key 一律不进 Git）
.env

# 用户上传的图片（运行时数据，不进 Git）
static/uploads/

# 编辑器与系统垃圾文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# v0.14.0-TST 安全加固：拦截本地测试垃圾与运行时密钥
temp/
.env.*
*.db-wal
*.db-shm
*.bak
backup/
.jwt_secret
